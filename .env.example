# LightPay backend variables — configure in your hosting secret settings.
# For local runs, copy to .env in each backend service (never commit it).
# Mobile receives only EXPO_PUBLIC_* variables. See DEPLOY.md.

# === Database ===
# One shared database for auth and fiat. URL takes precedence over POSTGRES_*.
# Format only: postgresql://USER:PASSWORD@HOST:5432/lightpay
DATABASE_URL=
# Defaults to TLS with certificate verification in production.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lightpay
POSTGRES_PASSWORD=lightpay_dev_secret
POSTGRES_DB=lightpay

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=lightpay_redis_secret

# === Auth Service ===
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
PIN_MAX_ATTEMPTS=5

# === SMS (Termii) ===
TERMII_API_KEY=
TERMII_BASE_URL=https://v4.api.termii.com
TERMII_SENDER_ID=LightPay

# === Email OTP (Brevo free plan, or SendGrid) ===
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Set EMAIL_PROVIDER=sendgrid to use an existing SendGrid account.
SENDGRID_API_KEY=
# Must match an approved sender in the selected provider account.
FROM_EMAIL=noreply@lightpay.ng

# === Paystack ===
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# === Flutterwave: outgoing African bank corridors ===
# Keep disabled until your account, FX/debit payloads and corridors are tested.
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_SECRET_KEY=
# Explicitly approved country codes only, e.g. NG,GH,KE. Empty disables all.
FLUTTERWAVE_ENABLED_COUNTRIES=

# === Prembly: BVN / NIN + face and liveness checks ===
PREMBLY_ENABLED=false
PREMBLY_ENVIRONMENT=live
PREMBLY_API_KEY=
PREMBLY_APP_ID=
# Actual HTTPS base URL from Prembly; include the trailing slash.
PREMBLY_API_BASE_URL=
# current_v1 or legacy_v2 according to your account's API contract.
PREMBLY_API_FORMAT=current_v1
# Stable dedicated random secret >=32 characters. Do not rotate casually.
PREMBLY_IDENTITY_HASH_KEY=

# === Expo push (fiat service) ===
# Required if enhanced push security is enabled in your Expo project.
EXPO_ACCESS_TOKEN=

# === VTPass (Bills) ===
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# === Mobile App ===
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_APP_VERSION=1.1.0
# Optional public mainnet connections for device-created/imported crypto wallets.
EXPO_PUBLIC_BITCOIN_API_URL=https://blockstream.info/api
EXPO_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
EXPO_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
EXPO_PUBLIC_BNB_RPC_URL=https://bsc-rpc.publicnode.com
# Recovery phrases and wallet passwords never belong in environment files.

# === Ports ===
GATEWAY_PORT=3000
# Auth uses PORT; gateway and fiat use their own port variables.
PORT=3001
FIAT_PORT=3002
AUTH_SERVICE_URL=http://localhost:3001
FIAT_SERVICE_URL=http://localhost:3002
# International payments and notifications run within fiat; KYC in auth.
# Crypto keys/signatures stay on the device; legacy server custody is retired.
